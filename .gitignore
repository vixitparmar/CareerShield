# ==========================================
# Root Workspace / Monorepo Ignore Rules
# ==========================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Environment and Secrets (CRITICAL: Never commit API keys)
.env
.env.*
!.env.example
*.pem
*.key

# Production & Build Artifacts
dist/
build/
out/
.next/

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDE & Editor Configurations
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Testing & Coverage
coverage/
.nyc_output/
*.lcov

# Temporary / Cache Files
.cache/
.parcel-cache/
.turbo/
tmp/
temp/